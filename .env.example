# Django deployment settings
SECRET_KEY=replace_with_a_strong_secret_key
DEBUG=False
ALLOWED_HOSTS=.railway.app,your-custom-domain.com

# MongoDB cache/gallery database
# URL-encode special characters in the password, e.g. @ becomes %40.
MONGO_URI=mongodb://localhost:27017/github-analyser

# Groq — powers CrewAI agents (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
CREWAI_DISABLE_CACHE=true
LITELLM_DISABLE_CACHE=true
LITELLM_CACHE=false

# Optional — raises GitHub API rate limits (https://github.com/settings/tokens)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat
